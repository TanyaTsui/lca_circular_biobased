# Copy to .env and fill in real values. Never commit .env (already gitignored).

# ecoinvent credentials, used by 01_dataPrep.ipynb (bi.import_ecoinvent_release)
# only needed the first time a given ecoinvent version is imported into Brightway.
ECOINVENT_USERNAME=
ECOINVENT_PASSWORD=

# premise decryption key for IAM scenario data, used by 01b_dataPrep_prospective.ipynb.
# Required for any premise.NewDatabase(...) call.
PREMISE_KEY=
